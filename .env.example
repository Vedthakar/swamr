# swamr itself needs no API keys: agents run through your logged-in Cursor CLI
# (`cursor agent login`).
#
# This file lists common keys the swarm's agents look for in the project they are
# building. Copy it into THAT project as `.env.local` (gitignored) and fill in
# only what your app uses. Missing keys don't crash the build — the agent writes
# a blocker to swamr/NEEDS-YOU.md and moves on.

# Supabase (hosted) — Dashboard → Settings → API
# Use NEXT_PUBLIC_* for Next.js or EXPO_PUBLIC_* for Expo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Payments — TEST MODE KEYS ONLY (sk_test_ / pk_test_). Agents are instructed
# never to use live keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional, only if your app uses maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
